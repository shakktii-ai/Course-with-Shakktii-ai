# ==============================================================================
# AI ACADEMY - ENTERPRISE LMS ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Configuration
NODE_ENV=development
APP_NAME="AI Academy"
APP_URL=http://localhost:3000
PORT=3000
API_BASE_PATH=/api/v1

# Security & Secrets
# Generate random 32+ char strings for session and token signing
SESSION_SECRET=change-this-to-a-secure-random-32-character-secret
JWT_SECRET=change-this-to-a-secure-random-32-character-secret

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_academy
MONGODB_MAX_POOL_SIZE=10

# AI Provider Configurations (Configurable adapters)
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudinary Image Hosting & Architecture Diagrams
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Object Storage (S3-Compatible / Cloudflare R2 - Optional for local dev)
STORAGE_PROVIDER=local
STORAGE_BUCKET=ai-academy-storage
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Mail / SMTP Configuration (Optional for local dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Academy <no-reply@aiacademy.local>"

# Payment Gateway (Razorpay or Stripe - Optional)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
